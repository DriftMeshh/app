{
  "name": "@driftmeshh/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "bindings/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspaces --if-present && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.8.0",
    "payment-streamer": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "subscription-market": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
