# Where /api/* is proxied to in dev (vite.config.ts) — the indexer.
VITE_INDEXER_URL=http://localhost:3002

# Used by write flows (subscribe, claim) via Freighter. See
# contracts/TESTNET.md for already-deployed testnet IDs.
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_PAYMENT_STREAMER_CONTRACT_ID=
VITE_SUBSCRIPTION_MARKET_CONTRACT_ID=

# Optional. A public Mapbox access token (safe to expose in frontend code —
# unlike a secret key, it's meant to be used this way) for the device map's
# dark basemap. Get one free at https://account.mapbox.com/access-tokens/.
# Leave unset and the map falls back to plain OpenStreetMap tiles with a
# CSS filter standing in for a dark style — see DeviceMap.tsx.
VITE_MAPBOX_TOKEN=
